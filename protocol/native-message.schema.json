{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeonZ03/Notion2DingDing/protocol/native-message.schema.json",
  "title": "Notion2DingDing Native Messaging Envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["protocolVersion", "requestId", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "oneOf": [
            {
              "$ref": "#/$defs/healthParams"
            },
            {
              "$ref": "#/$defs/localOpenParams"
            },
            {
              "$ref": "#/$defs/migrationExportParams"
            },
            {
              "$ref": "#/$defs/migrationTaskParams"
            }
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["protocolVersion", "requestId", "ok"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "required": ["result"],
            "not": { "required": ["error"] }
          },
          "else": {
            "required": ["error"],
            "not": { "required": ["result"] }
          }
        }
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/healthResult"
            },
            {
              "$ref": "#/$defs/localOpenResult"
            },
            {
              "$ref": "#/$defs/migrationExportInspection"
            },
            {
              "$ref": "#/$defs/migrationResult"
            },
            {
              "$ref": "#/$defs/migrationTaskSnapshot"
            }
          ]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "healthParams": {
      "type": "object",
      "additionalProperties": false
    },
    "localOpenParams": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["login", "target"] }
      }
    },
    "pageSnapshot": {
      "type": "object",
      "required": [
        "url",
        "title",
        "visibleTextBytes",
        "visibleBlockCount",
        "visibleImageCount",
        "exportRequired"
      ],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "maxLength": 4096 },
        "title": { "type": "string", "maxLength": 500 },
        "visibleTextBytes": { "type": "integer", "minimum": 0 },
        "visibleBlockCount": { "type": "integer", "minimum": 0 },
        "visibleImageCount": { "type": "integer", "minimum": 0 },
        "exportRequired": { "const": true }
      }
    },
    "migrationExportParams": {
      "type": "object",
      "required": ["fileName", "contentBase64"],
      "additionalProperties": false,
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "contentBase64": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "maxLength": 200 },
        "subpageMode": { "enum": ["inline", "tree"] },
        "createNew": { "type": "boolean" },
        "sourcePage": { "$ref": "#/$defs/pageSnapshot" }
      }
    },
    "migrationTaskParams": {
      "type": "object",
      "required": ["taskId"],
      "additionalProperties": false,
      "properties": {
        "taskId": { "type": "string", "minLength": 16, "maxLength": 16 }
      }
    },
    "healthResult": {
      "type": "object",
      "required": ["hostVersion", "protocolVersion", "platform", "capabilities", "localTool"],
      "additionalProperties": false,
      "properties": {
        "hostVersion": { "type": "string" },
        "protocolVersion": { "const": 1 },
        "platform": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "localTool": {
          "type": "object",
          "required": ["installed", "ready", "authenticated", "configured", "message"],
          "additionalProperties": false,
          "properties": {
            "installed": { "type": "boolean" },
            "version": { "type": "string" },
            "ready": { "type": "boolean" },
            "authenticated": { "type": "boolean" },
            "configured": { "type": "boolean" },
            "targetType": { "enum": ["folder", "workspace"] },
            "targetDisplayName": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "localOpenResult": {
      "type": "object",
      "required": ["started", "action", "message"],
      "additionalProperties": false,
      "properties": {
        "started": { "type": "boolean" },
        "action": { "enum": ["login", "target"] },
        "message": { "type": "string" }
      }
    },
    "migrationResult": {
      "type": "object",
      "required": [
        "taskId",
        "documentUrl",
        "reused",
        "expectedImageCount",
        "readbackImageCount",
        "nativeTodoCount",
        "cleanupVerified",
        "sourcePageCaptured"
      ],
      "additionalProperties": false,
      "properties": {
        "taskId": { "type": "string" },
        "remoteTaskId": { "type": "string" },
        "documentUrl": { "type": "string", "format": "uri" },
        "reused": { "type": "boolean" },
        "expectedImageCount": { "type": "integer", "minimum": 0 },
        "readbackImageCount": { "type": "integer", "minimum": 0 },
        "nativeTodoCount": { "type": "integer", "minimum": 0 },
        "nativeCodeBlockCount": { "type": "integer", "minimum": 0 },
        "nativeLayoutCount": { "type": "integer", "minimum": 0 },
        "nativeSubpageTocItemCount": { "type": "integer", "minimum": 0 },
        "subpageMode": { "enum": ["inline", "tree"] },
        "recursivePageCount": { "type": "integer", "minimum": 0 },
        "recursiveFolderCount": { "type": "integer", "minimum": 0 },
        "recursiveLinkCount": { "type": "integer", "minimum": 0 },
        "cleanupVerified": { "type": "boolean" },
        "sourcePageCaptured": { "type": "boolean" }
      }
    },
    "migrationExportInspection": {
      "type": "object",
      "required": ["fileName", "title", "exportedAt", "pageCount", "bytes"],
      "additionalProperties": false,
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "exportedAt": { "type": "string", "format": "date-time" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "previousExport": { "$ref": "#/$defs/migrationPreviousExport" }
      }
    },
    "migrationPreviousExport": {
      "type": "object",
      "required": ["status", "documentUrl", "updatedAt", "count", "subpageMode"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["success", "unknown"] },
        "documentUrl": { "type": "string", "format": "uri" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "count": { "type": "integer", "minimum": 1 },
        "subpageMode": { "enum": ["inline", "tree"] }
      }
    },
    "migrationTaskSnapshot": {
      "type": "object",
      "required": ["taskId", "status", "progress", "canCancel", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "taskId": { "type": "string", "minLength": 16, "maxLength": 16 },
        "status": {
          "enum": ["queued", "running", "cancel_requested", "succeeded", "failed", "unknown", "cancelled"]
        },
        "progress": {
          "type": "object",
          "required": ["current", "total", "percent", "stage", "message"],
          "additionalProperties": false,
          "properties": {
            "current": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1 },
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "stage": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "canCancel": { "type": "boolean" },
        "recoveryAction": { "enum": ["login", "target", "select_export", "retry", "recover"] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "result": { "$ref": "#/$defs/migrationResult" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "details": { "type": "object" }
          }
        }
      }
    }
  }
}
